#!/bin/bash
# Hook: PreToolUse(Bash) — suggest worktree for destructive git ops

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "${SCRIPT_DIR}/hook-utils"

INPUT=$(cat)

COMMAND=$(printf '%s' "$INPUT" | hook_command)

if echo "$COMMAND" | grep -qE "git (reset --hard|checkout -- \.|clean -f|clean -fd|branch -D)"; then
  emit_hook_context "PreToolUse" \
    "Destructive git operation detected. Resolve the exact target and preserve unrelated work; use an isolated git worktree when the operation is exploratory."
fi
