#!/bin/bash
# Hook: PreCompact — remind to update project skill if stale
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "${SCRIPT_DIR}/hook-utils"

STATE_FILE=".pipeline-state.json"
if [ ! -f "$STATE_FILE" ]; then exit 0; fi

UPDATED_AT=$(python3 -c "
import json
value = json.load(open('$STATE_FILE')).get('skill_updated_at')
print('' if value is None else value)
" 2>/dev/null)

if ! echo "$UPDATED_AT" | grep -qE '^[0-9]+$' || [ "$UPDATED_AT" -le 0 ] 2>/dev/null; then
  emit_hook_system_message \
    "Project skill has not been refreshed yet. Use LabMate's update-project-skill skill before context compacts."
  exit 0
fi

NOW=$(date +%s)
HOURS=$(( (NOW - UPDATED_AT) / 3600 ))

if [ "$HOURS" -gt 24 ]; then
  emit_hook_system_message \
    "Project skill is ${HOURS}h stale. Use LabMate's update-project-skill skill before context compacts."
fi
