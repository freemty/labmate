#!/bin/bash
# Inject only current LabMate state and the durable project-knowledge pointer.

set -euo pipefail

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
    LABMATE_RUNTIME="cursor"
elif [ -n "${PLUGIN_ROOT:-}" ] || [ -n "${CODEX_PLUGIN_ROOT:-}" ]; then
    LABMATE_RUNTIME="codex"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
    LABMATE_RUNTIME="claude"
else
    LABMATE_RUNTIME="unknown"
fi

escape_for_json() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\n'/\\n}"
    printf '%s' "$value"
}

if [ ! -f ".pipeline-state.json" ]; then
    context="<labmate state=\"uninitialized\" />"
else
    current_exp=$(python3 -c \
      "import json; print(json.load(open('.pipeline-state.json')).get('current_exp') or 'none')" \
      2>/dev/null || echo "unknown")
    stage=$(python3 -c \
      "import json; print(json.load(open('.pipeline-state.json')).get('stage') or 'unknown')" \
      2>/dev/null || echo "unknown")
    if [ "$LABMATE_RUNTIME" = "claude" ]; then
        project_skill=".claude/skills/project-skill/SKILL.md"
        fallback=".agents/skills/project-skill/SKILL.md"
    else
        project_skill=".agents/skills/project-skill/SKILL.md"
        fallback=".claude/skills/project-skill/SKILL.md"
    fi
    if [ ! -f "$project_skill" ] && [ -f "$fallback" ]; then
        project_skill="$fallback"
    fi
    context="<labmate exp=\"${current_exp}\" stage=\"${stage}\" project_skill=\"${project_skill}\" />"
fi

escaped=$(escape_for_json "$context")
if [ "$LABMATE_RUNTIME" = "cursor" ]; then
    printf '{\n  "additional_context": "%s"\n}\n' "$escaped"
else
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"
fi
