#!/bin/bash
# Surface a single archival hint only after a materially active git session.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "${SCRIPT_DIR}/hook-utils"

git rev-parse --git-dir >/dev/null 2>&1 || exit 0
recent_commits=$(git log --oneline --since="4 hours ago" 2>/dev/null | wc -l | tr -d ' ')
new_paths=$(git status --porcelain 2>/dev/null | grep -cE '^\\?\\?|^A |^ A' || true)

if [ "$recent_commits" -lt 3 ] 2>/dev/null && [ "$new_paths" -lt 5 ] 2>/dev/null; then
  exit 0
fi

emit_hook_system_message \
  "This session changed durable project state. Before compaction, archive only verified findings or non-obvious operational knowledge that is not already represented in project files."
