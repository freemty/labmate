#!/bin/bash
# Hook: PostToolUse(Bash) — remind to archive environment knowledge
# Detects env-related commands and suggests durable knowhow archival

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "${SCRIPT_DIR}/hook-utils"

INPUT=$(cat)

# Extract command (cheap — single jq)
COMMAND=$(printf '%s' "$INPUT" | hook_command)
if [ -z "$COMMAND" ]; then exit 0; fi

# Skip trivial commands early (before extracting output — saves 2x jq)
if echo "$COMMAND" | grep -qE '^(ls|cat|head|tail|pwd|cd|echo|wc|file|which|type)( |$)|^git (log|status|diff|branch|show)( |$)'; then
  exit 0
fi

MATCHED=0

# Signal 1: environment config commands
if echo "$COMMAND" | grep -qiE '(apt(-get)? install|pip install|conda install|docker (build|run|pull|push|compose)|ssh |scp |rsync |mount |umount |systemctl |nvidia-smi|chmod |chown |curl -[oOL]|wget |export [A-Z]|source.*activate|nvm |pyenv |brew install)'; then
  MATCHED=1
fi

# Signal 2: error keywords in output (only extract output if signal 1 didn't match)
if [ "$MATCHED" -eq 0 ]; then
  COMBINED=$(printf '%s' "$INPUT" | hook_response_text)
  if echo "$COMBINED" | grep -qiE '\b(error|failed|permission denied|not found|no such file|connection refused|timeout|OOM|out of memory|segfault|killed|errno)\b|CUDA error'; then
    MATCHED=1
  fi
fi

if [ "$MATCHED" -eq 0 ]; then exit 0; fi

# Frequency control: 5 min apart
if [ "$(should_remind knowhow_remind 0.083)" != "yes" ]; then exit 0; fi

# Session count check + increment. Reset when the hook session changes.
STATE_FILE=".labmate-hook-state.json"
SESSION_KEY=$(printf '%s' "$INPUT" \
  | jq -r '.session_id // .transcript_path // empty' 2>/dev/null)
if [ -z "$SESSION_KEY" ]; then
  SESSION_KEY="date:$(date +%Y-%m-%d)"
fi
ALLOWED=$(LABMATE_SESSION_KEY="$SESSION_KEY" LABMATE_STATE_FILE="$STATE_FILE" \
  python3 - <<'PY' 2>/dev/null || echo "yes"
import json
import os

path = os.environ["LABMATE_STATE_FILE"]
session_key = os.environ["LABMATE_SESSION_KEY"]
try:
    with open(path) as handle:
        state = json.load(handle)
except Exception:
    state = {}

entry = state.get("knowhow_session", {})
count = entry.get("count", 0) if entry.get("id") == session_key else 0
if count >= 3:
    print("no")
else:
    state["knowhow_session"] = {"id": session_key, "count": count + 1}
    state.pop("knowhow_session_count", None)
    with open(path, "w") as handle:
        json.dump(state, handle, indent=2)
    print("yes")
PY
)

if [ "$ALLOWED" != "yes" ]; then exit 0; fi

mark_reminded knowhow_remind

MESSAGE="<knowhow-hint>
刚才的操作看起来包含值得记录的环境知识。
如果问题已经定位并解决，使用 LabMate 的 update-docs skill 的 knowhow 分支归档 problem、cause、solution 和命令；如果尚未解决，继续诊断，不要归档猜测。
</knowhow-hint>"
emit_hook_context "PostToolUse" "$MESSAGE"
